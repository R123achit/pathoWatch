# PostgreSQL connection string (optional)
# Example for local dev: postgresql://postgres:password@localhost:5432/pathowatch
# DATABASE_URL=postgresql://user:password@localhost:5432/pathowatch

# ============================================
# ML API Configuration (REQUIRED for ML features)
# ============================================
# These should be set in Vercel as server-side environment variables
# DO NOT prefix with NEXT_PUBLIC_ to keep API key secure

PATHOWATCH_ML_API_URL=https://pathowatch-ml-api.onrender.com
PATHOWATCH_ML_API_KEY=your-api-key-here

# ============================================
# Next.js
# ============================================
NEXT_PUBLIC_APP_NAME=PathoWatch
